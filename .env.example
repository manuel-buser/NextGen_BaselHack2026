# Copy to .env (gitignored). The vision service and its scripts read it at start (code/bikeslot/config.py);
# a variable set in the shell wins over this file.

# OpenAI key, calibration only (VLM); either name works
MY_API_KEY=

# Live camera: the relay the camera pushes to over the phone hotspot (relay/README.md) and its view key,
# sent as X-View-Key. Camera on the LAN instead: BIKESLOT_PULL_CAMERAS=live01=http://192.168.21.95/snapshot, no key.
BIKESLOT_PULL_CAMERAS=live01=https://relay.manuel-buser.com/snapshot
BIKESLOT_PULL_VIEW_KEY=
