# Seeed XIAO ESP32S3 Sense: 8 MB flash, 8 MB octal PSRAM, console over the native USB port
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Performance settings recommended by the ESP-DL pedestrian_detect example
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n

# The detector runs inside the main loop and the HTTP server task: give them room
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Model compiled into the firmware image
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y

# HTTPS to the relay: mbedTLS buffers (~20 KB per connection) go to PSRAM. In internal RAM
# they don't fit next to the detector: mbedtls_ssl_setup fails with -0x008D (out of memory).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
